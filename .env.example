# Copy to .env.local (git-ignored) and fill in. Never commit real passwords.

# SQLite file for users and sessions (default: data/europe-intelligence.db)
# DATABASE_PATH=data/europe-intelligence.db

# Default accounts, created at server start only if the username does not exist yet.
# Existing accounts are never modified, so changing these later does not reset a password.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_USER_USERNAME=user_avs
DEFAULT_USER_PASSWORD=
